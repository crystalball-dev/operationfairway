# ── Public ────────────────────────────────────────────────────────────────
# Canonical site URL, no trailing slash. Drives metadataBase, sitemap, OG image URLs.
# On Vercel: set to https://operationfairway.org in Production; Preview deployments
# can leave it unset (the site falls back to the value in src/content/site.ts).
NEXT_PUBLIC_SITE_URL=https://operationfairway.org

# ── Contact form ──────────────────────────────────────────────────────────
# Delivery via Resend (https://resend.com; the free plan is plenty). RESEND_API_KEY is the
# only setting needed once operationfairway.org is verified in Resend, and one Resend account
# covers both operationfairway.org and ojinyx.com. Without it the form still renders, but a
# submit falls back to a prefilled email to site.email.
RESEND_API_KEY=
# Optional override. Where messages are delivered; defaults to site.email.
CONTACT_TO_EMAIL=hello@operationfairway.org
# Optional override. The sender; defaults to site.contactFrom. Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=site@operationfairway.org
