# ── Public ────────────────────────────────────────────────────────────────
# Canonical site URL, no trailing slash. Drives metadataBase, sitemap, OG image URLs.
# On Vercel: set to https://operationfairway.org in Production; Preview deployments
# can leave it unset (the site falls back to the value in src/content/site.ts).
NEXT_PUBLIC_SITE_URL=https://operationfairway.org

# ── Contact form (optional) ──────────────────────────────────────────────
# Delivery via Resend (https://resend.com — free tier is plenty). When RESEND_API_KEY is
# unset the form still renders but submits fall back to a mailto: link to site.email.
RESEND_API_KEY=
# Where messages are delivered.
CONTACT_TO_EMAIL=hello@operationfairway.org
# Must be a sender on a domain you've verified in Resend.
CONTACT_FROM_EMAIL=site@operationfairway.org
